// Rusted Soft Minimal fastfetch theme: braille emblem, graphite/lavender, compact modules.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "padding": { "top": 0, "left": 0, "right": 2 },
    "color": { "1": "magenta", "2": "blue" },
    "position": "left"
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "magenta", "title": "magenta", "output": "white", "separator": "dim_magenta" },
    "key": { "width": 11 },
    "bar": {
      "char": { "elapsed": "▄", "total": "▄" },
      "border": null,
      "width": 10,
      "color": { "total": "#343a4e" }
    },
    "percent": { "type": ["num", "bar"] }
  },
  "modules": [
    "title",
    { "type": "separator", "string": "─", "outputColor": "blue" },
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "terminal",
    { "type": "command", "key": "CPU",
      "text": "lscpu | sed -n 's/^Model name:[[:space:]]*//p' | sed 's/(R)//g; s/(TM)//g; s/13th Gen //; s/ CPU @.*//'" },
    { "type": "gpu", "format": "{name}" },
    { "type": "memory", "key": "RAM", "format": "{percentage-bar}  {percentage}  ({used} / {total})" },
    { "type": "disk", "key": "DISK", "folders": "/", "format": "{size-percentage-bar}  {size-percentage}  ({size-used} / {size-total})" },
    { "type": "colors", "symbol": "circle" }
  ]
}
