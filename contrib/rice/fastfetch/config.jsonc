// Rusted Soft Minimal fastfetch theme: braille emblem, graphite/lavender, compact modules.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "padding": { "top": 0, "left": 0, "right": 2 },
    "color": { "1": "magenta", "2": "blue" },
    "position": "left"
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "magenta", "title": "magenta", "output": "white", "separator": "dim_magenta" },
    "key": { "width": 11 }
  },
  "modules": [
    "title",
    { "type": "separator", "string": "─", "outputColor": "blue" },
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "terminal",
    { "type": "command", "key": "CPU",
      "text": "lscpu | sed -n 's/^Model name:[[:space:]]*//p' | sed 's/(R)//g; s/(TM)//g; s/13th Gen //; s/ CPU @.*//'" },
    { "type": "gpu", "format": "{name}" },
    "memory",
    { "type": "disk", "folders": "/" },
    { "type": "colors", "symbol": "circle" }
  ]
}
