#!/usr/bin/env python3
"""Run one Waybar bar per monitor, each showing that monitor's own workspaces.

Usage: rusted-waybar [--config FILE] [--style FILE]   (put it in `autostart`)
       rusted-waybar --print OUTPUT...                  print the generated config and exit

Takes your Waybar config as a template (default ~/.config/waybar/config.jsonc, else the one
shipped with rusted-wm), copies the bar once per output with "output": NAME and replaces the
"@OUTPUT@" placeholder with that name, then keeps Waybar running. When a monitor is plugged or
unplugged the bars are regenerated and Waybar is restarted.
"""
import copy, json, os, signal, subprocess, sys, time

HERE = os.path.dirname(os.path.realpath(__file__))
WM = os.environ.get("RUSTED_WM", "rusted-wm")


def find(name, explicit):
    candidates = [explicit] if explicit else []
    candidates += [
        os.path.expanduser(f"~/.config/waybar/{name}"),
        os.path.join(HERE, "waybar", name),
        os.path.join(HERE, "..", "share", "rusted-wm", "waybar", name),
        os.path.join(HERE, "..", "contrib", "waybar", name),
    ]
    for c in candidates:
        if c and os.path.exists(c):
            return c
    return None


def strip_comments(text):
    """Remove // and /* */ comments outside of strings (Waybar accepts JSONC)."""
    out, i, n, in_str = [], 0, len(text), False
    while i < n:
        c = text[i]
        if in_str:
            out.append(c)
            if c == "\\":
                out.append(text[i + 1]); i += 1
            elif c == '"':
                in_str = False
        elif c == '"':
            in_str = True; out.append(c)
        elif text.startswith("//", i):
            while i < n and text[i] != "\n":
                i += 1
            continue
        elif text.startswith("/*", i):
            i = text.find("*/", i) + 2 or n
            continue
        else:
            out.append(c)
        i += 1
    return "".join(out)


def substitute(value, name):
    if isinstance(value, str):
        return value.replace("@OUTPUT@", name)
    if isinstance(value, list):
        return [substitute(v, name) for v in value]
    if isinstance(value, dict):
        return {k: substitute(v, name) for k, v in value.items()}
    return value


def build(template, outputs):
    bars = []
    for name in outputs:
        bar = substitute(copy.deepcopy(template), name)
        bar["output"] = name
        bar["name"] = f"rusted-{name}"
        bars.append(bar)
    return bars


def outputs():
    try:
        info = subprocess.run([WM, "ctl", "info"], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return []
    names = []
    for line in info.splitlines():
        if line.startswith("output "):
            for part in line.split():
                if part.startswith("name="):
                    names.append(part[5:])
    return names


def main():
    args = sys.argv[1:]
    config = style = None
    while args and args[0] in ("--config", "--style"):
        if args[0] == "--config":
            config = args[1]
        else:
            style = args[1]
        args = args[2:]
    config_path = find("config.jsonc", config) or find("config", config)
    if not config_path:
        sys.exit("rusted-waybar: no Waybar config found (put one in ~/.config/waybar/config.jsonc)")
    with open(config_path) as f:
        template = json.loads(strip_comments(f.read()))
    if args[:1] == ["--print"]:
        print(json.dumps(build(template, args[1:]), indent=2))
        return

    style_path = find("style.css", style)
    runtime = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
    generated = os.path.join(runtime, "rusted-waybar.json")
    child, current = None, None

    def stop(*_):
        if child and child.poll() is None:
            child.terminate()
        sys.exit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    while True:
        names = outputs()
        if names and names != current:
            if child and child.poll() is None:
                child.terminate()
                child.wait()
            with open(generated, "w") as f:
                json.dump(build(template, names), f)
            cmd = ["waybar", "-c", generated] + (["-s", style_path] if style_path else [])
            child, current = subprocess.Popen(cmd), names
        elif child and child.poll() is not None:
            current = None  # Waybar died: start it again on the next round
        time.sleep(2)


if __name__ == "__main__":
    main()
